<script>
  // Fills in hex values and contrast ratios from the live page, so they follow the theme.
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = 1;
  const ctx = canvas.getContext('2d', { willReadFrequently: true })!;

  function rgb(role: string): [number, number, number] {
    const probe = document.createElement('i');
    probe.style.color = `var(${role})`;
    document.body.append(probe);
    const resolved = getComputedStyle(probe).color;
    probe.remove();
    ctx.clearRect(0, 0, 1, 1);
    ctx.fillStyle = '#000';
    ctx.fillStyle = resolved;
    ctx.fillRect(0, 0, 1, 1);
    const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
    return [r, g, b];
  }
  const hex = (c: number[]) => '#' + c.map((v) => v.toString(16).padStart(2, '0')).join('');
  const lum = (c: number[]) => {
    const [r, g, b] = c
      .map((v) => v / 255)
      .map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  };
  const ratio = (a: number[], b: number[]) => {
    const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
    return (hi + 0.05) / (lo + 0.05);
  };

  function paint() {
    document.querySelectorAll<HTMLElement>('[data-hex]').forEach((el) => {
      el.textContent = hex(rgb(el.dataset.hex!));
    });
    document.querySelectorAll<HTMLElement>('[data-contrast]').forEach((row) => {
      const r = ratio(rgb(row.dataset.fg!), rgb(row.dataset.bg!));
      row.querySelector('[data-ratio]')!.textContent = r.toFixed(2) + ':1';
      const level = r >= 7 ? 'AAA' : r >= 4.5 ? 'AA' : r >= 3 ? 'Large text only' : 'Fail';
      row.querySelector('[data-level]')!.innerHTML =
        `<span class="inline-flex rounded-full border px-2.5 py-0.5 text-xs font-medium ${
          r >= 4.5
            ? 'border-success-line bg-success-soft text-success'
            : 'border-danger-line bg-danger-soft text-danger'
        }">${level}</span>`;
    });
  }

  paint();
  new MutationObserver(paint).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });
</script>
