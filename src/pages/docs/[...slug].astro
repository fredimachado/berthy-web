---
// One page of the docs: an entry of the "docs" collection (see src/lib/split-guide.ts).
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import Prose from '../../components/Prose.astro';
import { getDocs, buildNav } from '../../lib/docs-nav.ts';
import { GROUPS } from '../../lib/split-guide.ts';

export async function getStaticPaths() {
  const docs = await getDocs();
  const nav = buildNav(docs);
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry, nav } }));
}

const { entry, nav } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, group, url, source, sha } = entry.data;
const groupTitle = GROUPS.find((g) => g.id === group)!.title;
---

<DocsLayout
  title={title}
  description={description}
  headings={headings}
  current={url}
  nav={nav}
  crumbs={[
    { label: 'Docs', href: '/docs' },
    { label: groupTitle, href: `/docs#${group}` },
    { label: entry.data.label },
  ]}
  editPath={source}
  sha={sha}
  section={groupTitle}
>
  <Prose>
    <h1 data-pagefind-weight="10" data-pagefind-meta="title">
      {title}
    </h1>
    <Content />
  </Prose>
</DocsLayout>
