---
// The Berthy mark: a "B" drawn as a quay post (the stem) with two berths (the bowls) moored to it.
// One stroke weight, round ends, readable at 16px, and it works in one colour.
interface Props {
  /** Show the word "Berthy" next to the mark. */
  wordmark?: boolean;
  size?: number;
  class?: string;
}
const { wordmark = true, size = 28, class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    viewBox="0 0 32 32"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
    class="shrink-0"
  >
    <rect width="32" height="32" rx="8" fill="var(--accent)"></rect>
    <path
      d="M10.5 8v16M10.5 8h6a4 4 0 0 1 0 8h-6m0 0h7a4 4 0 0 1 0 8h-7"
      fill="none"
      stroke="var(--accent-fg)"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  {wordmark ? (
    <span class="text-lg font-semibold tracking-tight text-fg">Berthy</span>
  ) : (
    <span class="sr-only">Berthy</span>
  )}
</span>
