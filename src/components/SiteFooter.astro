---
import Logo from './Logo.astro';
import Container from './Container.astro';
import { SITE, footerLinks } from '../lib/site.ts';
import source from '../content/berthy/source.json';
---

<footer class="mt-24 border-t border-line bg-surface-2">
  <Container size="wide" class="py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-3 text-sm text-fg-muted">{SITE.tagline}</p>
      </div>
      {footerLinks.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="text-sm font-semibold">{col.title}</h2>
          <ul class="mt-3 grid gap-2">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener' : undefined}
                  class="text-sm text-fg-muted transition-colors duration-(--duration-fast) hover:text-fg"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <p class="mt-10 border-t border-line pt-6 text-sm text-fg-subtle">
      <a
        class="underline underline-offset-2 hover:text-fg"
        href={`${SITE.repo}/blob/main/LICENSE`}
        target="_blank"
        rel="noopener"
      >
        MIT
      </a>{' '}
      licensed, source on GitHub. Docs are synced from{' '}
      <a
        class="font-mono underline underline-offset-2 hover:text-fg"
        href={`${SITE.repo}/commit/${source.sha}`}
        target="_blank"
        rel="noopener"
      >
        berthy@{source.sha.slice(0, 7)}
      </a>
      . Built with Astro and Tailwind CSS.
    </p>
  </Container>
</footer>
