---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Kbd from './Kbd.astro';
import ThemeToggle from './ThemeToggle.astro';
import VersionSelect from './VersionSelect.astro';
import { SITE, primaryNav, versions } from '../lib/site.ts';

interface Props {
  /** Current pathname, to mark the matching nav link. */
  current?: string;
  /** Show the documentation version selector. */
  showVersion?: boolean;
}

const { current = '', showVersion = false } = Astro.props;
// The most specific nav link that contains the current path is the active one.
const owner = primaryNav
  .filter(
    (l) => !l.external && (current === l.href || current.startsWith(l.href.replace(/\/?$/, '/'))),
  )
  .sort((a, b) => b.href.length - a.href.length)[0];
const active = (href: string) => (owner?.href === href ? true : undefined);
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-[90rem] items-center gap-3 px-4 sm:px-6 lg:px-8">
    <a href="/" class="mr-2 rounded-md" aria-label="Berthy, home">
      <Logo />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-0.5 md:flex">
      {primaryNav.map((link) => (
        <a
          href={link.href}
          aria-current={active(link.href) ? 'page' : undefined}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener' : undefined}
          class="rounded-md px-3 py-1.5 text-sm font-medium text-fg-muted transition-colors duration-(--duration-fast) hover:text-fg aria-[current=page]:bg-surface-2 aria-[current=page]:text-fg"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button
        type="button"
        data-search-open
        aria-haspopup="dialog"
        aria-label="Search documentation"
        class="flex h-9 items-center gap-2 rounded-lg border border-line bg-surface-2 px-2.5 text-sm text-fg-muted transition-colors duration-(--duration-fast) hover:border-line-strong hover:text-fg md:w-40 md:px-3 lg:w-64 xl:w-72"
      >
        <Icon name="search" size={16} />
        <span class="hidden flex-1 text-left md:block">Search docs</span>
        <span class="hidden items-center gap-1 md:flex" aria-hidden="true">
          <Kbd>
            <span data-mod>⌘</span>
          </Kbd>
          <Kbd>K</Kbd>
        </span>
      </button>

      {showVersion && (
        <div class="hidden sm:block">
          <VersionSelect versions={versions} current={versions[0].label} />
        </div>
      )}

      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener"
        aria-label="Berthy on GitHub"
        class="grid size-9 place-items-center rounded-lg text-fg-muted transition-colors duration-(--duration-fast) hover:bg-surface-2 hover:text-fg"
      >
        <Icon name="github" size={18} />
      </a>

      <ThemeToggle />

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        class="grid size-9 place-items-center rounded-lg text-fg-muted hover:bg-surface-2 hover:text-fg md:hidden"
      >
        <Icon name="menu" size={20} class="[[aria-expanded=true]>&]:hidden" />
        <Icon name="x" size={20} class="hidden [[aria-expanded=true]>&]:block" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-line bg-bg md:hidden">
    <nav aria-label="Primary, mobile" class="mx-auto max-w-[90rem] px-4 py-3 sm:px-6">
      <ul class="grid gap-0.5">
        {primaryNav.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={active(link.href) ? 'page' : undefined}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener' : undefined}
              class="flex items-center justify-between rounded-lg px-3 py-2.5 text-base font-medium text-fg-muted hover:bg-surface-2 hover:text-fg aria-[current=page]:bg-surface-2 aria-[current=page]:text-fg"
            >
              {link.label}
              {link.external && <Icon name="external-link" size={14} />}
            </a>
          </li>
        ))}
      </ul>
      {showVersion && (
        <p class="mt-3 flex flex-wrap items-center gap-2 border-t border-line px-3 pt-3 text-sm text-fg-muted">
          Version{' '}
          {versions.map((v, i) => (
            <a
              href={v.href}
              target={v.external ? '_blank' : undefined}
              rel={v.external ? 'noopener' : undefined}
              aria-current={i === 0 ? 'true' : undefined}
              class="rounded-md border border-line px-2 py-0.5 hover:text-fg aria-[current=true]:border-accent-line aria-[current=true]:bg-accent-soft aria-[current=true]:text-accent-text"
            >
              {v.label}
            </a>
          ))}
        </p>
      )}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');

  function set(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.hidden = !open;
  }

  toggle?.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) set(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      set(false);
      toggle.focus();
    }
  });
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && set(false));
</script>
