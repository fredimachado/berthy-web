---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  /** Renders an <a> when set, a <button> otherwise. */
  href?: string;
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [attr: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  icon,
  iconPosition = 'start',
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const variants = {
  primary: 'bg-accent text-accent-fg shadow-xs hover:bg-accent-hover border border-transparent',
  secondary: 'bg-surface text-fg border border-line-strong shadow-xs hover:bg-surface-2',
  ghost: 'bg-transparent text-fg-muted border border-transparent hover:bg-surface-2 hover:text-fg',
};
const sizes = {
  sm: 'h-8 px-3 text-sm gap-1.5',
  md: 'h-10 px-4 text-sm gap-2',
  lg: 'h-12 px-6 text-base gap-2.5',
};
const iconSize = { sm: 14, md: 16, lg: 18 }[size];

const classes = [
  'inline-flex items-center justify-center rounded-lg font-medium whitespace-nowrap select-none',
  'transition-colors duration-(--duration-fast) ease-(--ease-standard)',
  'disabled:pointer-events-none disabled:opacity-50',
  variants[variant],
  sizes[size],
  className,
];
const Tag = href ? 'a' : 'button';
---

<Tag class:list={classes} href={href} type={href ? undefined : type} {...rest}>
  {icon && iconPosition === 'start' && <Icon name={icon} size={iconSize} />}
  <slot />
  {icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} />}
</Tag>
