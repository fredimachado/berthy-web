---
// Inline SVG icons from Lucide, read at build time: nothing ships to the browser but the paths used.
// Lucide renamed some icons; its aliases resolve here, so old names keep working.
import lucide from '@iconify-json/lucide/icons.json';

export type IconName = keyof typeof lucide.icons | keyof typeof lucide.aliases | 'github';

interface Props {
  name: IconName;
  /** Width and height in px (default 16). */
  size?: number;
  class?: string;
  /** Set only when the icon carries meaning on its own; otherwise it is hidden from assistive tech. */
  label?: string;
  strokeWidth?: number;
}

const { name, size = 16, class: className, label, strokeWidth = 2 } = Astro.props;

// GitHub's mark is not in Lucide (brand icons were removed): the Octicons path, drawn filled.
const GITHUB =
  'M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z';

const icons = lucide.icons as Record<string, { body: string }>;
const aliases = lucide.aliases as Record<string, { parent: string }>;
const entry = icons[name] ?? icons[aliases[name]?.parent ?? ''];
if (name !== 'github' && !entry) throw new Error(`Unknown icon "${name}"`);

const github = name === 'github';
// Lucide bodies hardcode stroke-width 2; scale it when asked.
const body = github ? '' : entry.body.replace('stroke-width="2"', `stroke-width="${strokeWidth}"`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={github ? '0 0 16 16' : '0 0 24 24'}
  width={size}
  height={size}
  fill={github ? 'currentColor' : 'none'}
  class:list={['shrink-0', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {github ? <path d={GITHUB} /> : <Fragment set:html={body} />}
</svg>
